# Voult – environment template
# Copy to apps/server/.env and fill values. Never commit real secrets.
# See google-drive-cloud-sync.md §4.4 and https://developers.google.com/workspace/drive/api/guides/about-sdk

# === Environment (single canonical key) ===
# VOULT_ENV: Optional, defaults to "production" if unset.
#   Allowed values: "development" | "production" (case-insensitive). Panics on any other value.
#   - development: dev DB at apps/server/voult.db (absolute), launcher no auto-start/auto-open
#   - production:  prod DB at ~/Library/Application Support/Voult/voult.db, launcher auto-start
# See apps/server/src/config.rs for mandatory/optional table.
VOULT_ENV=development

# === Logging (shared by server + launcher) ===
# VOULT_LOG_LEVEL: minimum level for all server and launcher logging.
# Values: debug | log | warn | error (case-insensitive; info aliases log).
# Default: log. Also controls Actix/SeaORM/SQLx via the global `log` backend;
# RUST_LOG is ignored.
# VOULT_LOG_LEVEL=debug

# === Core server (all Optional with defaults) ===
# DATABASE_URL: Optional, defaults by VOULT_ENV. Panics if set but empty.
DATABASE_URL=sqlite://voult.db?mode=rwc
# SESSION_COOKIE_KEY: Optional, generated per-install if unset. Must be >=64 chars if set (panics otherwise).
SESSION_COOKIE_KEY=change-me-to-at-least-64-random-characters-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Optional tuning (all Optional):
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAME_SITE=lax
# SESSION_TTL_SECONDS=604800
# STATIC_DIR=../client/dist

# --- Google Drive (Phase 3 local Rust transport) ---
# One-time developer setup: create project in https://console.cloud.google.com,
# enable Drive API (https://console.cloud.google.com/apis/library/drive.googleapis.com),
# configure OAuth consent screen, add test users while in Testing mode.
# Create OAuth 2.0 client of type "Web application".
# See https://developers.google.com/identity/protocols/oauth2/web-server

# OAuth client from Google Cloud Console (do NOT commit real secret)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Exact redirect URI registered in Google Cloud Console.
# Must match the local server's callback endpoint. For local dev use:
# Register this exact callback URI in the Google OAuth console.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/cloud/oauth/callback?provider=google_drive
# Legacy alias also accepted: GOOGLE_REDIRECT_URI

# Narrowest Drive scope for appDataFolder (hidden app-only storage, not visible in Drive UI)
# https://developers.google.com/workspace/drive/api/guides/appdata
# https://developers.google.com/workspace/drive/api/guides/api-specific-auth
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.appdata

# Where to redirect the browser after successful Google OAuth (frontend vault chooser)
GOOGLE_POST_AUTH_REDIRECT=http://localhost:8081/vault

# --- Dropbox (optional provider) ---
# Register an App folder app in the Dropbox App Console and register this exact
# OAuth redirect URI. App folder files are stored as voult-vault-<uuid>.json.
# Enable account_info.read, files.content.read, files.content.write, and
# files.metadata.read in the app's Permissions tab, then generate a new token.
DROPBOX_CLIENT_ID=your-dropbox-app-key
DROPBOX_CLIENT_SECRET=your-dropbox-app-secret
DROPBOX_OAUTH_REDIRECT_URI=http://localhost:8080/api/cloud/oauth/callback?provider=dropbox
# DROPBOX_POST_AUTH_REDIRECT=http://localhost:8081/vault

# --- Optional production ---
# Before public release: publish OAuth consent screen, verify authorized domains,
# add privacy/support URLs, and complete Google verification if scopes require it.
