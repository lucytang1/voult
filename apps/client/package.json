{
  "name": "pass-manager-client",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "EXPO_PUBLIC_API_URL= expo export --platform web",
    "sync:sqlite-web": "mkdir -p public/sqlite && cp node_modules/@sqlite.org/sqlite-wasm/dist/sqlite3-worker1.mjs public/sqlite/sqlite3-worker1.mjs && cp node_modules/@sqlite.org/sqlite-wasm/dist/sqlite3-opfs-async-proxy.js public/sqlite/sqlite3-opfs-async-proxy.js && cp node_modules/@sqlite.org/sqlite-wasm/dist/sqlite3.wasm public/sqlite/sqlite3.wasm",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.6",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@sqlite.org/sqlite-wasm": "3.51.2-build6",
    "@tanstack/react-query": "^5.90.20",
    "axios": "^1.13.4",
    "expo": "^55.0.5",
    "expo-application": "~55.0.8",
    "expo-constants": "~55.0.7",
    "expo-device": "~55.0.9",
    "expo-font": "~55.0.4",
    "expo-linking": "~55.0.7",
    "expo-localization": "~55.0.8",
    "expo-router": "~55.0.4",
    "expo-status-bar": "~55.0.4",
    "gl-matrix": "^3.4.4",
    "lucide-react": "^0.562.0",
    "nativewind": "^5.0.0-preview.2",
    "posthog-react-native": "^4.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-wgpu": "^0.4.2",
    "react-native-worklets": "0.7.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "typegpu": "^0.9.0",
    "unified": "^11.0.5",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "~19.2.10",
    "@types/react-native-web": "^0.19.2",
    "@webgpu/types": "^0.1.68",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.6",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react-native-svg-transformer": "^1.5.2",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.2",
    "wrangler": "^4.59.3"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "private": true
}
